class ConditionEvaluator:
    def __init__(self, repo_context: dict, jira_context: dict, logger):
        self._repo = repo_context
        self._jira = jira_context
        self._log = logger
        self._custom_variables: dict[str, str] = {}  # skill-defined variables

    def load_skill_variables(self, variables: dict[str, str]) -> None:
        """Load computed variables defined in a skill YAML.

        Each variable maps a name to a condition expression.
        When a step condition references this name, it is expanded
        and evaluated as a sub-condition.

        Args:
            variables: Dict of variable_name -> condition_expression from skill YAML.

        Raises:
            ConditionError: If a variable references itself (circular dependency).
        """
        # Validate no circular references
        for name, expr in variables.items():
            if name in expr:
                raise ConditionError(f"Circular variable reference: '{name}' references itself")
        self._custom_variables = variables

    def evaluate(self, condition: str) -> ConditionResult:
        """Evaluate a condition expression against repo context.

        Resolution order:
        1. Check if condition is a skill-defined variable name → expand and evaluate
        2. Check if condition is a comparison (var == value) → resolve variable and compare
        3. Check if condition is a function call → execute function
        4. Check if condition is compound (and/or/not) → split and evaluate parts
        5. Check if condition is a built-in variable name → return its value as bool

        Args:
            condition: Condition expression string from skill YAML.

        Returns:
            ConditionResult with result, evidence, and variables used.
        """
        condition = condition.strip()

        # Empty or "true" condition → always active
        if not condition or condition.lower() == "true":
            return ConditionResult(
                condition=condition,
                result=True,
                evidence="No condition specified — step always runs",
                variables_used={}
            )

        # Check if this is a skill-defined variable name
        if condition in self._custom_variables:
            expanded = self._custom_variables[condition]
            self._log.debug(
                "Expanding skill variable",
                extra={"variable": condition, "expanded": expanded}
            )
            result = self.evaluate(expanded)
            return ConditionResult(
                condition=condition,
                result=result.result,
                evidence=f"Variable '{condition}' expanded to '{expanded}' → {result.evidence}",
                variables_used={condition: expanded, **result.variables_used}
            )

        # Handle compound conditions (and / or / not)
        # Handle comparisons
        # Handle function calls
