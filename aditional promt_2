**Applying gap analysis suggestions:**

```python
def _apply_gap_analysis(
    self,
    layer1_result: LayerOneResult,
    gap_analysis: GapAnalysisResult,
    min_confidence: str = "medium"
) -> LayerOneResult:
    """Apply LLM gap analysis suggestions to the Layer 1 plan.

    Rules:
    1. Only apply suggestions with confidence >= min_confidence
    2. "reactivate_step" moves a step from skipped to active, tagged with source="llm_gap_analysis"
    3. "add_step" creates a new ResolvedStep, tagged with source="llm_gap_analysis"
    4. "reorder" changes step ordering within a phase
    5. "remove_step" moves a step from active to skipped (rare, needs high confidence)
    6. Every applied suggestion is logged in the audit trail

    Args:
        layer1_result: The deterministic plan from Layer 1.
        gap_analysis: LLM suggestions from Layer 2.
        min_confidence: Minimum confidence to apply a suggestion ("high", "medium", "low").

    Returns:
        Modified LayerOneResult with gap analysis suggestions applied.
    """
    confidence_order = {"high": 3, "medium": 2, "low": 1}
    min_level = confidence_order.get(min_confidence, 2)

    applied = []
    rejected = []

    for suggestion in gap_analysis.suggestions:
        level = confidence_order.get(suggestion.confidence, 0)
        if level < min_level:
            rejected.append(suggestion)
            self._log.info(
                "Gap analysis suggestion rejected — below confidence threshold",
                extra={
                    "step": suggestion.step_name,
                    "confidence": suggestion.confidence,
                    "threshold": min_confidence,
                    "type": suggestion.type,
                }
            )
            continue

        # Apply the suggestion based on type
        if suggestion.type == "reactivate_step":
            # Find the step in skipped, move to active
            ...
        elif suggestion.type == "add_step":
            # Create new ResolvedStep with source="llm_gap_analysis"
            new_step = ResolvedStep(
                name=suggestion.step_name,
                agent="coder_agent",
                instruction=suggestion.instruction,
                tools_needed=["file_tool", "build_tool", "search_tool"],
                verify=None,
                loop=True,
                max_iterations=10,
                context=f"LLM-discovered: {suggestion.reason}\nEvidence: {suggestion.evidence}",
                condition=None,
                condition_result=None,
                status="active",
                skip_reason=None,
                source="llm_gap_analysis",  # NEW field — tags where this step came from
            )
            ...
        elif suggestion.type == "reorder":
            ...
        elif suggestion.type == "remove_step":
            # Only with high confidence
            if suggestion.confidence != "high":
                rejected.append(suggestion)
                continue
            ...

        applied.append(suggestion)

    self._log.info(
        "Gap analysis complete",
        extra={
            "applied": len(applied),
            "rejected": len(rejected),
            "risk": gap_analysis.risk_assessment,
        }
    )

    return modified_result
```

