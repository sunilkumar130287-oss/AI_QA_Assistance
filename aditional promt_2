    derived = {}

    # Version jump calculations (generic — works for any version pair)
    current_java = self._repo.get("java_version")
    target_java = self._runtime_variables.get("target_java_version")
    if current_java is not None and target_java is not None:
        derived["java_version_jump"] = int(target_java) - int(current_java)

    current_angular = self._repo.get("angular_version")
    target_angular = self._runtime_variables.get("target_angular_version")
    if current_angular is not None and target_angular is not None:
        derived["angular_version_jump"] = int(target_angular) - int(current_angular)

    # Generic version jump — works if skill sets "current_version" and "target_version"
    current = self._runtime_variables.get("current_version")
    target = self._runtime_variables.get("target_version")
    if current is not None and target is not None:
