### 2.5 — The unified planning flow

Tie all three layers together:

```python
def run(self, task_context: dict) -> AgentResult:
    """Execute three-layer planning.

    Flow:
    1. Load skill + variables
    2. Layer 1: Deterministic condition evaluation
    3. Layer 2: LLM gap analysis (if enabled in config)
    4. Merge Layer 1 + Layer 2
    5. Build ResolvedPlan
    6. Layer 3: LLM plan validation (if enabled in config)
    7. Handle validation issues
    8. Output final ResolvedPlan to state manager

    Config controls:
        agents.planner.enable_gap_analysis: true/false (default: true)
        agents.planner.enable_plan_validation: true/false (default: true)
        agents.planner.gap_analysis_min_confidence: "high"|"medium"|"low" (default: "medium")
    """
    skill = task_context["skill"]
    repo_context = task_context["repo_context"]
    jira_context = task_context["jira_context"]

    # Load skill-defined variables into evaluator
    if "variables" in skill:
        self._evaluator.load_skill_variables(skill["variables"])

    # LAYER 1: Deterministic resolution
    self._log.info("Planning Layer 1: Deterministic condition evaluation")
    layer1 = self._layer1_deterministic_resolution(skill, repo_context, jira_context)
    self._log.info(
        "Layer 1 complete",
        extra={"active": len(layer1.active_steps), "skipped": len(layer1.skipped_steps)}
    )

    # LAYER 2: LLM gap analysis
    combined_active = list(layer1.active_steps)
    combined_skipped = list(layer1.skipped_steps)

    if self._config.get("enable_gap_analysis", True):
        self._log.info("Planning Layer 2: LLM gap analysis")
        gap_result = self._layer2_gap_analysis(layer1, skill, repo_context, jira_context)

        if gap_result.suggestions:
            self._log.info(
                "Gap analysis found suggestions",
                extra={
                    "count": len(gap_result.suggestions),
                    "risk": gap_result.risk_assessment,
                }
            )
            modified = self._apply_gap_analysis(
                layer1,
                gap_result,
                min_confidence=self._config.get("gap_analysis_min_confidence", "medium")
            )
            combined_active = modified.active_steps
            combined_skipped = modified.skipped_steps
    else:
        gap_result = None

    # Build the ResolvedPlan from combined results
    plan = self._build_resolved_plan(skill, combined_active, combined_skipped, layer1, gap_result)

    # LAYER 3: Plan validation
    if self._config.get("enable_plan_validation", True):
        self._log.info("Planning Layer 3: LLM plan validation")
        validation = self._layer3_plan_validation(plan, skill, repo_context, jira_context)

        if validation.blocking_issues:
            self._log.warning(
                "Plan validation found blocking issues",
                extra={"count": len(validation.blocking_issues)}
            )
            plan = self._handle_validation_issues(plan, validation)

        if validation.iteration_adjustments:
            plan = self._apply_iteration_adjustments(plan, validation.iteration_adjustments)

        # Save validation result to state
        self._state.set("planner", "validation_result", {
            "blocking_issues": [asdict(i) for i in validation.blocking_issues],
            "warnings": [asdict(w) for w in validation.warnings],
            "criteria_coverage": [asdict(c) for c in validation.criteria_coverage],
            "overall_assessment": validation.overall_assessment,
        })
    else:
        validation = None

    # Save complete planning audit trail
    self._state.set("planner", "planning_audit", {
        "layer1_active": len(layer1.active_steps),
        "layer1_skipped": len(layer1.skipped_steps),
        "layer2_applied": len(gap_result.suggestions) if gap_result else 0,
        "layer2_risk": gap_result.risk_assessment if gap_result else "n/a",
        "layer3_blocking": len(validation.blocking_issues) if validation else 0,
        "layer3_assessment": validation.overall_assessment if validation else "n/a",
        "final_active": plan.total_active_steps,
        "final_skipped": plan.total_skipped_steps,
    })

    self._log.info(
        "Planning complete — all layers",
        extra={
            "final_active_steps": plan.total_active_steps,
            "final_skipped_steps": plan.total_skipped_steps,
            "gap_analysis_risk": gap_result.risk_assessment if gap_result else "disabled",
            "validation_assessment": validation.overall_assessment if validation else "disabled",
        }
    )

    return AgentResult(
        status="complete",
        output=asdict(plan),
        iterations=1,
        tool_calls=[],
        token_usage=self._llm.get_usage_stats(),
    )
