# Torri LLM Proxy Configuration
TORRI_BASE_URL=https://torri.company.com/v1
TORRI_API_KEY=your-torri-api-key-here
TORRI_MODEL=gpt-4o

# Jira Configuration
JIRA_BASE_URL=https://jira.company.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_USERNAME=your.email@company.com

# Git Configuration (for PR creation)
GIT_PROVIDER=github
GIT_API_TOKEN=your-git-api-token-here
GIT_API_URL=https://api.github.com

# Optional overrides
# EXECUTION_WORKING_DIR=./workspace
# LOG_LEVEL=INFO
# MAX_AGENT_ITERATIONS=25
